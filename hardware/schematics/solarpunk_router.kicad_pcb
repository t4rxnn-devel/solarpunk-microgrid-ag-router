(kicad_pcb (version 20221018) (generator "pcbnew")
  (paper "A3")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (32 "B.Adhes" user "B.Adhesive")
    (33 "F.Adhes" user "F.Adhesive")
    (34 "B.Paste" user)
    (35 "F.Paste" user)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (38 "B.Mask" user)
    (39 "F.Mask" user)
    (40 "Dwgs.User" user "Drawing.User")
    (41 "Cmts.User" user "Comment.User")
    (42 "Eco1.User" user "Eco1.User")
    (43 "Eco2.User" user "Eco2.User")
    (44 "Edge.Cuts" user)
    (45 "Margin" user)
    (46 "B.CrtYd" user "B.Courtyard")
    (47 "F.CrtYd" user "F.Courtyard")
    (48 "B.Fab" user)
    (49 "F.Fab" user)
  )
  (setup
    (stackup
      (layer "F.Cu" (thickness 0.035) (type copper))
      (layer "Core" (thickness 1.51) (type dielectric) (material "FR4") (perm_permittivity 4.5) (loss_tangent 0.02))
      (layer "B.Cu" (thickness 0.035) (type copper))
      (soldermask_min_thickness 0.01)
      (silk_screen_clearance 0.15)
    )
    (pad_to_mask_clearance 0.05)
    (solder_mask_min_width 0.1)
    (track_width 0.25)
    (via_drill 0.3)
    (via_size 0.6)
  )
  ; Board Outline: 120mm x 80mm Industrial Form Factor
  (gr_line (start 0 0) (end 120 0) (layer "Edge.Cuts") (width 0.1) (uuid "edge-line-1"))
  (gr_line (start 120 0) (end 120 80) (layer "Edge.Cuts") (width 0.1) (uuid "edge-line-2"))
  (gr_line (start 120 80) (end 0 80) (layer "Edge.Cuts") (width 0.1) (uuid "edge-line-3"))
  (gr_line (start 0 80) (end 0 0) (layer "Edge.Cuts") (width 0.1) (uuid "edge-line-4"))

  ; Footprint Placements for Core ICs and Power Switches
  (footprint "Package_DIP:Teensy4.1" (layer "F.Cu") (at 30 30 0) (uuid "fp-teensy-41"))
  (footprint "Package_TO_SOT_THT:TO-220AB_Vertical" (layer "F.Cu") (at 90 30 0) (uuid "fp-mosfet-q1"))
  (footprint "Package_SO:SOIC-8_3.9x4.9mm_P1.27mm" (layer "F.Cu") (at 60 50 0) (uuid "fp-driver-u2"))
  (footprint "Package_SO:SOT-23-8_L2.9-W1.6-P0.65mm" (layer "F.Cu") (at 60 30 0) (uuid "fp-sensor-u3"))
)
